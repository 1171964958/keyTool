<Window
    x:Class="KeyTool.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:KeyTool.Windows.Controls"
    Title="KeyTool"
    Width="1180"
    Height="780"
    MinWidth="980"
    MinHeight="660"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource CanvasBrush}"
    FontFamily="Segoe UI"
    FontSize="13"
    Foreground="{StaticResource TextBrush}"
    SourceInitialized="OnSourceInitialized"
    Closing="OnClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="8,10,8,22">
                    <Border
                        Width="36"
                        Height="36"
                        CornerRadius="10"
                        Background="{StaticResource PrimaryBrush}">
                        <TextBlock
                            Text="⌘"
                            Foreground="White"
                            FontSize="20"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,1,0,0">
                        <TextBlock Text="KeyTool" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Windows 按键助手" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>

                <Button
                    Grid.Row="1"
                    Command="{Binding OpenManagementCommand}"
                    Margin="0,0,0,16">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsManagement}" Value="True">
                                    <Setter Property="Background" Value="#E7E4FC" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" Margin="0,0,9,0" />
                        <TextBlock Text="任务管理" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="任务"
                        Style="{StaticResource MutedText}"
                        Margin="10,0,10,8" />
                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Tasks}"
                        SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource TaskListItem}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding Summary}"
                                            Style="{StaticResource MutedText}"
                                            Margin="0,3,0,0"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            Fill="{StaticResource RunningBrush}"
                                            Visibility="{Binding Runtime.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Text="{Binding Runtime.CurrentLoop}"
                                            Foreground="{StaticResource RunningBrush}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding Runtime.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,12,0,2">
                    <Button
                        Command="{Binding NewTaskCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" Margin="0,0,7,0" />
                            <TextBlock Text="新建任务" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

        <Grid Grid.Column="2">
            <Grid
                Visibility="{Binding IsManagement, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="26,20,26,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="任务管理" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock
                            Text="集中查看执行状态、快捷控制与任务配置"
                            Style="{StaticResource MutedText}"
                            Margin="0,5,0,0" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Command="{Binding NewTaskCommand}"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" Margin="0,0,7,0" />
                            <TextBlock Text="新建任务" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26,22,26,30">
                        <UniformGrid Columns="4" Margin="0,0,0,22">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding TaskCount}" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="任务总数" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding RunningCount}" Foreground="{StaticResource RunningBrush}" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="正在执行" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ScheduledCount}" Foreground="#178A82" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="自动计划" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ShortcutTaskCount}" Foreground="{StaticResource PrimaryBrush}" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="已设快捷键" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="全部任务" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="38"
                                                Height="38"
                                                CornerRadius="10"
                                                Background="#EEECFC"
                                                VerticalAlignment="Top">
                                                <TextBlock
                                                    FontFamily="Segoe Fluent Icons"
                                                    Text="&#xE756;"
                                                    Foreground="{StaticResource PrimaryBrush}"
                                                    FontSize="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,18,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Background="#FFF1E1"
                                                        CornerRadius="8"
                                                        Padding="7,2"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding Runtime.IsRunning, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="执行中" Foreground="{StaticResource RunningBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                    <TextBlock Text="{Binding ScheduleSummary}" Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="  ·  " Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="{Binding ShortcutSummary}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Text="{Binding HotKeyError}"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    FontSize="11"
                                                    Margin="0,4,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button
                                                    Command="{Binding DataContext.ToggleRunCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,7,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Setter Property="Content" Value="运行" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Runtime.IsRunning}" Value="True">
                                                                    <Setter Property="Content" Value="停止" />
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button
                                                    Content="编辑"
                                                    Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="0,0,7,0" />
                                                <Button
                                                    Content="更多"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Click="OpenAttachedContextMenu">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem
                                                                Header="编辑任务"
                                                                Command="{Binding PlacementTarget.Tag.EditTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                            <MenuItem
                                                                Header="复制任务"
                                                                Command="{Binding PlacementTarget.Tag.DuplicateTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                            <Separator />
                                                            <MenuItem
                                                                Header="删除任务"
                                                                Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Background="#FFF8EF"
                                                CornerRadius="9"
                                                Padding="12,9"
                                                Margin="12,12,0,0"
                                                Visibility="{Binding Runtime.IsRunning, Converter={StaticResource BoolToVisibility}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="{Binding Runtime.ProgressText}"
                                                        Foreground="{StaticResource MutedBrush}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Content="停止任务"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.ToggleRunCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource QuietButton}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border
                            Style="{StaticResource CardStyle}"
                            Padding="34"
                            Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    FontFamily="Segoe Fluent Icons"
                                    Text="&#xE80F;"
                                    FontSize="34"
                                    Foreground="{StaticResource MutedBrush}"
                                    HorizontalAlignment="Center" />
                                <TextBlock Text="还没有任务" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center" />
                                <TextBlock Text="新建一个任务，设置动作序列、窗口目标和全局快捷键。" Style="{StaticResource MutedText}" />
                                <Button Content="新建任务" Command="{Binding NewTaskCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding IsEditor, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="26,16,26,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Content="任务管理"
                        Command="{Binding OpenManagementCommand}"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Top"
                        Margin="0,4,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBox
                            Text="{Binding SelectedTask.Name, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0"
                            MinHeight="38" />
                        <TextBlock Text="{Binding SelectedTask.Summary}" Style="{StaticResource MutedText}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Command="{Binding ToggleRunCommand}"
                        CommandParameter="{Binding SelectedTask}"
                        Padding="20,10"
                        VerticalAlignment="Top">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="运行" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTask.Runtime.IsRunning}" Value="True">
                                        <Setter Property="Content" Value="立即停止" />
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26,20,26,34">
                        <Border
                            Style="{StaticResource CardStyle}"
                            Background="#FFF8EF"
                            BorderBrush="#F0D4AE"
                            Visibility="{Binding SelectedTask.Runtime.IsRunning, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="执行中" Foreground="{StaticResource RunningBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedTask.Runtime.ProgressText}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="停止任务"
                                    Command="{Binding ToggleRunCommand}"
                                    CommandParameter="{Binding SelectedTask}"
                                    Style="{StaticResource SecondaryButton}"
                                    Foreground="{StaticResource DangerBrush}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="目标窗口" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        ItemsSource="{Binding AvailableWindows}"
                                        SelectedItem="{Binding SelectedTask.Target, Mode=TwoWay}"
                                        DisplayMemberPath="DisplayName"
                                        MinHeight="36"
                                        Padding="8,5"
                                        VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshWindowsCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Content="使用当前前台" Command="{Binding CaptureForegroundWindowCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="按键输入方式" VerticalAlignment="Center" />
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{Binding SelectedTask.KeyboardInputModes}"
                                        SelectedItem="{Binding SelectedTask.KeyboardInputMode, Mode=TwoWay}"
                                        MinHeight="34"
                                        Padding="8,4"
                                        VerticalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock
                                    Text="“自适应”在目标前台时使用真实输入；后台任务首次发送时会建立一次受控激活，直到停止任务或真正切回游戏才结束，避免每个技能反复切换焦点。“纯后台消息”完全不激活目标，但部分 Unity 游戏可能忽略按键。"
                                    Style="{StaticResource MutedText}"
                                    TextWrapping="Wrap"
                                    Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Border
                                    Background="#FFF8EF"
                                    CornerRadius="9"
                                    Padding="11,8"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding Recorder.IsRecording, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="正在录制操作" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding Recorder.RecordedCount, StringFormat=已捕获 {0} 个动作，切换回 KeyTool 后停止录制}"
                                                Style="{StaticResource MutedText}"
                                                Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Content="停止并保存"
                                            Command="{Binding ToggleRecordingCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Foreground="{StaticResource DangerBrush}" />
                                    </Grid>
                                </Border>

                                <TextBlock
                                    Text="{Binding Recorder.ErrorMessage}"
                                    Foreground="{StaticResource DangerBrush}"
                                    FontSize="11"
                                    Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="动作序列" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Content="录制操作"
                                        Command="{Binding ToggleRecordingCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,7,0" />
                                    <Button
                                        Grid.Column="2"
                                        Content="添加动作"
                                        Style="{StaticResource SecondaryButton}"
                                        Tag="{Binding}"
                                        Click="OpenAttachedContextMenu">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="按键" Command="{Binding PlacementTarget.DataContext.AddActionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" CommandParameter="Keyboard" />
                                                <MenuItem Header="鼠标点击" Command="{Binding PlacementTarget.DataContext.AddActionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" CommandParameter="MouseClick" />
                                                <MenuItem Header="鼠标移动" Command="{Binding PlacementTarget.DataContext.AddActionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" CommandParameter="MouseMove" />
                                                <MenuItem Header="鼠标滚动" Command="{Binding PlacementTarget.DataContext.AddActionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" CommandParameter="Scroll" />
                                                <Separator />
                                                <MenuItem Header="等待" Command="{Binding PlacementTarget.DataContext.AddActionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" CommandParameter="Delay" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding SelectedTask.Actions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="#FAFAFC"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Content="↑" Style="{StaticResource QuietButton}"
                                                                    Command="{Binding DataContext.MoveActionUpCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="↓" Style="{StaticResource QuietButton}"
                                                                    Command="{Binding DataContext.MoveActionDownCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="删除" Foreground="{StaticResource DangerBrush}" Style="{StaticResource QuietButton}"
                                                                    Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,9,0,0"
                                                        Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibility}}">
                                                        <controls:ShortcutCaptureButton
                                                            Gesture="{Binding Shortcut, Mode=TwoWay}"
                                                            Style="{StaticResource SecondaryButton}" />
                                                        <Border
                                                            Background="#FAFAFC"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Margin="9,0,0,0"
                                                            Padding="10,0"
                                                            Height="34">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock
                                                                    Text="次数"
                                                                    Foreground="{StaticResource MutedBrush}"
                                                                    VerticalAlignment="Center" />
                                                                <TextBox
                                                                    Width="58"
                                                                    MaxLength="5"
                                                                    Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                                    TextAlignment="Right"
                                                                    Margin="8,0,0,0"
                                                                    Padding="7,4"
                                                                    MinHeight="0"
                                                                    BorderThickness="1"
                                                                    ToolTip="重复发送此按键的次数，范围 1 到 10,000" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <Grid Margin="0,9,0,0" Visibility="{Binding IsMouseClick, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBox Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                        <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="12,0,6,0" />
                                                        <TextBox Grid.Column="3" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                        <ComboBox Grid.Column="4" ItemsSource="{Binding MouseButtons}" SelectedItem="{Binding MouseButton}" Margin="12,0,0,0" MinWidth="86" VerticalContentAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Button Grid.Column="6" Content="使用当前鼠标" Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding DataContext.UseCursorCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>

                                                    <Grid Margin="0,9,0,0" Visibility="{Binding IsMouseMove, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBox Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                        <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="12,0,6,0" />
                                                        <TextBox Grid.Column="3" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                        <Button Grid.Column="5" Content="使用当前鼠标" Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding DataContext.UseCursorCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>

                                                    <Grid Margin="0,9,0,0" Visibility="{Binding IsScroll, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="水平" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBox Grid.Column="1" Text="{Binding DeltaX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                        <TextBlock Grid.Column="2" Text="垂直" VerticalAlignment="Center" Margin="12,0,6,0" />
                                                        <TextBox Grid.Column="3" Text="{Binding DeltaY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                                    </Grid>

                                                    <Grid Margin="0,9,0,0" Visibility="{Binding IsDelay, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="等待" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBox Grid.Column="1" Text="{Binding DelaySeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Style="{StaticResource InputBox}" />
                                                        <TextBlock Grid.Column="2" Text="秒（支持小数）" VerticalAlignment="Center" Margin="7,0,0,0" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="快捷控制" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启动任务" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" />
                                    <controls:ShortcutCaptureButton
                                        Grid.Column="1"
                                        Gesture="{Binding SelectedTask.Shortcuts.Start, Mode=TwoWay}"
                                        Style="{StaticResource SecondaryButton}" />
                                    <Button Grid.Column="2" Content="清除" Command="{Binding ClearStartShortcutCommand}" Style="{StaticResource QuietButton}" Margin="6,0,0,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="停止任务" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" />
                                    <controls:ShortcutCaptureButton
                                        Grid.Column="1"
                                        Gesture="{Binding SelectedTask.Shortcuts.Stop, Mode=TwoWay}"
                                        Style="{StaticResource SecondaryButton}" />
                                    <Button Grid.Column="2" Content="清除" Command="{Binding ClearStopShortcutCommand}" Style="{StaticResource QuietButton}" Margin="6,0,0,0" />
                                </Grid>
                                <TextBlock
                                    Text="{Binding SelectedTask.HotKeyError}"
                                    Foreground="{StaticResource DangerBrush}"
                                    FontSize="11"
                                    Margin="110,7,0,0" />
                                <TextBlock
                                    Text="支持单个按键，也可继续使用 Ctrl、Alt、Shift、Win 组合键。快捷键在 KeyTool 位于托盘时仍然生效。"
                                    Style="{StaticResource MutedText}"
                                    Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="执行计划" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="循环次数" VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Text="{Binding SelectedTask.LoopCount, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource InputBox}"
                                        IsEnabled="{Binding SelectedTask.Runtime.IsRunning, Converter={StaticResource InverseBool}}" />
                                    <CheckBox
                                        Grid.Column="2"
                                        Content="无限循环"
                                        IsChecked="{Binding SelectedTask.IsLoopInfinite}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <CheckBox Content="启用自动执行" IsChecked="{Binding SelectedTask.IsScheduleEnabled}" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="计划" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SelectedTask.Schedule.Modes}" SelectedItem="{Binding SelectedTask.Schedule.Mode}" VerticalContentAlignment="Center" MinHeight="34">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedTask.Schedule.IsInterval, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="时间间隔" VerticalAlignment="Center" Width="110" />
                                    <TextBox Text="{Binding SelectedTask.Schedule.IntervalSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Style="{StaticResource InputBox}" Width="100" />
                                    <TextBlock Text="秒（0.05–86,400，支持小数）" VerticalAlignment="Center" Margin="7,0,0,0" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedTask.Schedule.IsDaily, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="每天时间" VerticalAlignment="Center" Width="110" />
                                    <TextBox Text="{Binding SelectedTask.Schedule.Hour, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Width="62" />
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" />
                                    <TextBox Text="{Binding SelectedTask.Schedule.Minute, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Width="62" />
                                </StackPanel>
                                <TextBlock
                                    Text="无限循环会持续执行，直到点击“立即停止”或使用停止快捷键。"
                                    Style="{StaticResource MutedText}"
                                    Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Text="{Binding SelectedTask.Runtime.ErrorMessage}"
                            Foreground="{StaticResource DangerBrush}"
                            Margin="2,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
